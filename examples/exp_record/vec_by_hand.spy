"""
Lowered code of a `Record` class, written by hand.

The user code that a metaclass will receive in part B is:

    class Vec(metaclass=Record):
        x: i32
        y: i32

This file is what the metaclass has to generate: ordinary `@struct` classes and
functions, with no metaclass. It has no support for protocols (no `__erase__`,
no `__unerase__`).

`Vec` is a *wrapper*: its only field is a pointer to the data, so copying a `Vec`
copies the pointer. The data are in `Vec_data`, allocated on the heap.
"""

from operator import OpSpec
from unsafe import gc_ptr, gc_alloc


@struct
class Vec:
    # The only field: a pointer to the data. `Vec_data` is defined below, after `Vec`:
    # the layout of `Vec` only needs the size of a pointer, not the one of `Vec_data`.
    __ll__: gc_ptr[Vec_data]

    # `v.x` and `v.y`: the compiler calls this metafunction for each attribute read.
    @blue.metafunc
    def __getattribute__(m_self, m_name):
        name = m_name.blueval           # the name of the attribute, known at compile time
        if name == "x":

            def get_x(self: Vec, attr: str) -> i32:
                return self.__ll__.x

            return OpSpec(get_x)
        if name == "y":

            def get_y(self: Vec, attr: str) -> i32:
                return self.__ll__.y

            return OpSpec(get_y)
        # Not a field (for example `__ll__`): default lookup. Needs M1.10, otherwise
        # reading `self.__ll__` above would call this hook again, forever.
        return OpSpec.NULL

    # `v.x = value` and `v.y = value`: same thing for attribute writes.
    @blue.metafunc
    def __setattr__(m_self, m_name, m_v):
        name = m_name.blueval
        if name == "x":

            def set_x(self: Vec, attr: str, v: i32) -> None:
                self.__ll__.x = v

            return OpSpec(set_x)
        if name == "y":

            def set_y(self: Vec, attr: str, v: i32) -> None:
                self.__ll__.y = v

            return OpSpec(set_y)
        return OpSpec.NULL

    # `Vec(x, y)`: allocate one `Vec_data` on the heap, wrap the pointer, then run
    # `__init__`.
    def __new__(x: i32, y: i32) -> Vec:
        self = Vec.__make__(gc_alloc[Vec_data](1))
        self.__init__(x, y)
        return self

    # The following methods are generated from the fields, since the user wrote none
    # of them.
    def __init__(self: Vec, x: i32, y: i32) -> None:
        self.x = x
        self.y = y

    def __eq__(self: Vec, other: Vec) -> bool:
        return self.x == other.x and self.y == other.y

    # `__ne__` is written explicitly: once `__eq__` exists, the compiler does not
    # add it.
    def __ne__(self: Vec, other: Vec) -> bool:
        return not (self == other)

    def __repr__(self: Vec) -> str:
        return "Vec(x=" + repr(self.x) + ", y=" + repr(self.y) + ")"

    # `a is b`: two variables are the same object when they hold the same address.
    # Needs M1.11.
    @blue.metafunc
    def __is__(m_self, m_other):
        def impl(self: Vec, other: Vec) -> bool:
            return self.__ll__ == other.__ll__

        return OpSpec(impl, [m_self, m_other])


# The data, defined after the wrapper.
@struct
class Vec_data:
    x: i32
    y: i32
