"""
User code: this is all that a user of `Record` has to write.

DOES NOT RUN YET, see stdlib/metaclasses/record.spy and README.md.
"""

from record import Record


class Point(metaclass=Record):
    x: i32
    y: i32

    def __init__(self, x: i32, y: i32) -> None:
        self.x = x
        self.y = y

    def norm2(self) -> i32:
        return self.x * self.x + self.y * self.y
