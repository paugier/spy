"""
The code that `class Point(metaclass=Record)` (see point_record.spy) generates,
written by hand.

It is ordinary `@struct` classes and functions, with no metaclass. Compared to what
stdlib/metaclasses/record.spy really produces, it has no support for protocols (no
`__erase__`, no `__unerase__`, no class info).

DOES NOT RUN YET, see README.md. point_simple.spy is a version that runs.
"""

from operator import OpSpec
from unsafe import gc_ptr, gc_alloc


@blue
def make_Point():
    fields = {"x": i32, "y": i32}
    cname = "Point"

    names = (*fields.keys(),)
    types = (*fields.values(),)
    N = len(names)

    @struct
    class cls:
        __ll__: gc_ptr[Data]

        # The following methods are generated from the fields, since the user wrote none
        # of them.

        def __init__(self: cls, *args: *types) -> None:
            for i in unroll_range(N):
                setattr(self, names[i], args[i])

        def __eq__(self: cls, other: cls) -> bool:
            for i in unroll_range(N):
                if getattr(self, names[i]) != getattr(other, names[i]):
                    return False
            return True

        def __ne__(self: cls, other: cls) -> bool:
            return not (self == other)

        @blue.metafunc
        def __getattribute__(m_self, m_name):
            name = m_name.blueval
            if name in fields:
                T = fields[name]

                def get(self: cls, attr: str) -> T:
                    return getattr(self.__ll__, name)

                return OpSpec(get)
            if name in all_base:
                T = all_base[name]

                def get_inherited(self: cls, attr: str) -> T:
                    return getattr(up(self), name)

                return OpSpec(get_inherited)
            return OpSpec.NULL

        @blue.metafunc
        def __setattr__(m_self, m_name, m_v):
            name = m_name.blueval
            if name in fields:
                T = fields[name]

                def set(self: cls, attr: str, v: T) -> None:
                    setattr(self.__ll__, name, v)

                return OpSpec(set)
            if name in all_base:
                T = all_base[name]

                def set_inherited(self: cls, attr: str, v: T) -> None:
                    setattr(up(self), name, v)

                return OpSpec(set_inherited)
            return OpSpec.NULL

        @blue.metafunc
        def __new__(*args_m):
            arg_types = args_m.types

            def new(*args: *arg_types) -> cls:
                self = cls.__make__(gc_alloc[Data](1))
                self.__init__(*args)
                return self

            return OpSpec(new)

        def __repr__(self) -> str:
            s = cname + "("
            for i in unroll_range(N):
                if i > 0:
                    s = s + ", "
                s = s + names[i] + "=" + repr(getattr(self, names[i]))
            return s + ")"

        # `a is b`: two variables are the same object when they hold the same address.
        @blue.metafunc
        def __is__(m_self, m_other):
            def impl(self: cls, other: cls) -> bool:
                return self.__ll__ == other.__ll__

            return OpSpec(impl, [m_self, m_other])

        # user code
        def norm2(self) -> i32:
            return self.x * self.x + self.y * self.y

    # The data, defined after the wrapper.
    @struct
    class Data:
        x: i32
        y: i32

    return cls


Point = make_Point()
