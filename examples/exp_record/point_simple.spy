"""
Simplified `Point`, written by hand, that runs.

Same layout as point_by_hand.spy (a `Data` struct holding the fields, and a
`Point` struct wrapping a `gc_ptr[Data]`: copying a `Point` copies the pointer,
which gives reference semantics), but with the parts that the compiler does not
support yet left out:

- no `__is__` hook, so `p is q` is rejected: test_identity is expected to fail,
- `__init__` is written by the user instead of being generated by `Record`.
"""

from operator import OpSpec
from unsafe import gc_ptr, gc_alloc


@blue
def make_Point():

    cname = "Point"

    @struct
    class Data:
        x: i32
        y: i32

    @struct
    class cls:
        __ll__: gc_ptr[Data]

        @blue.metafunc
        def __getattribute__(m_self, m_name):
            name = m_name.blueval
            if name == "x":

                def get_x(self: cls, attr: str) -> i32:
                    return self.__ll__.x

                return OpSpec(get_x)
            if name == "y":

                def get_y(self: cls, attr: str) -> i32:
                    return self.__ll__.y

                return OpSpec(get_y)
            return OpSpec.NULL

        @blue.metafunc
        def __setattr__(m_self, m_name, m_v):
            name = m_name.blueval
            if name == "x":

                def set_x(self: cls, attr: str, v: i32) -> None:
                    self.__ll__.x = v

                return OpSpec(set_x)
            if name == "y":

                def set_y(self: cls, attr: str, v: i32) -> None:
                    self.__ll__.y = v

                return OpSpec(set_y)
            return OpSpec.NULL

        def __new__(x: i32, y: i32) -> cls:
            self = cls.__make__(gc_alloc[Data](1))
            self.__init__(x, y)
            return self

        def __init__(self, x: i32, y: i32) -> None:
            self.x = x
            self.y = y

        def __eq__(self: cls, other: cls) -> bool:
            return self.x == other.x and self.y == other.y

        def __ne__(self: cls, other: cls) -> bool:
            return not (self == other)

        def __repr__(self: cls) -> str:
            # return f"{cname}(x={self.x!r}, y={self.y!r})"
            return cname + "(x=" + repr(self.x) + ", y=" + repr(self.y) + ")"

        def norm2(self) -> i32:
            return self.x * self.x + self.y * self.y

    return cls


Point = make_Point()


def main() -> None:
    p = Point(3, 4)
    print(p.norm2())
    p.x = 10
    print(p.x)

    # reference semantics: q and p are the same object
    q = p
    q.y = 99
    print(p.y)
    print(p.__ll__ == q.__ll__)
    print(p.__ll__ == Point(10, 99).__ll__)
