"""
Experiment: the `@heap` decorator, written with blue metaprogramming.

DOES NOT RUN YET. See README.md for the list of missing features: in
particular, the parser only accepts `@struct` as a class decorator.

`heap(cls)` receives the class written by the user and returns the wrapper
struct, i.e. what point_by_hand.spy writes by hand. The user code is in
point_heap.spy.
"""

from operator import OpSpec
from unsafe import gc_ptr, gc_alloc
from __spy__ import unroll_range


@blue
def heap(cls):
    # Invented API, similar to what the dataclass note needs: the user's class
    # is exposed as an ordered {name: type} dict of fields...
    fields = cls.__annotations__  # {"x": i32, "y": i32}
    # ...and an ordered {name: method} dict (__init__, norm2, ...). These are
    # method *templates*: their `self` is not bound to any class yet.
    methods = cls.__methods__
    method_names = (*methods.keys(),)
    N = len(method_names)

    @struct
    class _data:
        __extra_fields__ = fields

    @struct
    class _heap:
        __ll__: gc_ptr[_data]

        @blue.metafunc
        def __getattribute__(m_self, m_name):
            name = m_name.blueval
            if name not in fields:
                # not a field: fall back to the default lookup (methods, __ll__)
                return OpSpec.NULL
            T = fields[name]

            def get(self: _heap, attr: str) -> T:
                return getattr(self.__ll__, name)

            return OpSpec(get)

        @blue.metafunc
        def __setattr__(m_self, m_name, m_v):
            name = m_name.blueval
            if name not in fields:
                return OpSpec.NULL
            T = fields[name]

            def set(self: _heap, attr: str, v: T) -> None:
                setattr(self.__ll__, name, v)

            return OpSpec(set)

        @blue.metafunc
        def __new__(*m_args):
            arg_types = m_args.types

            def new(*args: tuple[*arg_types]) -> _heap:
                self = _heap.__make__(gc_alloc[_data](1))
                self.__init__(*args)
                return self

            return OpSpec(new)

        @blue.metafunc
        def __is__(m_self, m_other):
            def impl(self: _heap, other: _heap) -> bool:
                return self.__ll__ == other.__ll__

            return OpSpec(impl, [m_self, m_other])

        # Inject the user-written methods. Proposed syntax: an unrolled loop
        # in the class body (like `unroll_range` in function bodies), which
        # binds one class attribute per iteration. `locals()` is the class
        # namespace, as in a Python class body; since `i` is blue, each
        # iteration binds a statically-known name. Assigning a method template
        # re-evaluates its `def` in this class scope, so that `self` is
        # `_heap` and not the original class.
        for i in unroll_range(N):
            locals()[method_names[i]] = methods[method_names[i]]

    return _heap
