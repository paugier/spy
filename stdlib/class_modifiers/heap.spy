"""
Experiment: `@heap` in the phased style

DOES NOT RUN. Everything described as "invented" does not exist in SPy.

A class modifier is a struct. For `@a @b class C(Base)`, once the body of C
has been executed, the compiler calls these blue hooks, in this order:

  1. a.__transform__(cls, body) -> body       optional; closest decorator first
     Base.__transform_subclass__(cls, body)   optional; for each base, after
                                              the decorators ("the class wins")
  2. m.__define__(cls, body)                  exactly one modifier; defines
                                              `cls` (and creates other types)
  3. a.__after__(cls)                         optional

`cls` is the type that was declared when the module started. The methods of the
body are already typed with it: `self: cls`.

Invented API:
  body.fields     ordered {name: type}: the lines `x: i32`
  body.methods    ordered {name: Method}
  Method          .argtypes (without self), .restype, .is_required (the body
                  is `...`), .bind(Self) -> function whose `self` is Self
  @struct.define(cls) class _: ...
                  a class statement that does not create a type: its body
                  defines the already declared `cls`
  __extra_fields__, __extra_methods__
                  merged into the type. The values of __extra_methods__ are
                  Methods (bound to the type being defined) or functions.

User code:

    @heap
    class Point:
        x: i32
        y: i32

        def __init__(self, x: i32, y: i32) -> None:
            self.x = x
            self.y = y
"""

from operator import OpSpec
from unsafe import gc_ptr, gc_alloc, ptr_cast  # ptr_cast: name used in the page


@struct
class heap:
    @blue
    def __define__(cls, body):
        fields = body.fields  # {"x": i32, "y": i32}
        types = (*fields.values(),)  # (i32, i32)

        # Order matters. A struct needs the size of its fields, and the size of
        # a type is known only once it is defined. `cls` only needs a pointer
        # to Data (Data is declared, since the top-level classes of a blue
        # function are declared when the function starts), so `cls` is defined
        # first. Then Data can have a field of type `cls` (a linked list...).
        @struct.define(cls)
        class _:
            __ll__: gc_ptr[Data]
            # The user's methods. Their `self` is already `cls`, which is the
            # wrapper: no re-typing is needed. (The more general alternative is
            # a blue `for` loop in this class body.)
            __extra_methods__ = body.methods

            @blue.metafunc
            def __getattribute__(m_self, m_name):
                name = m_name.blueval
                if name not in fields:
                    # not a field: default lookup (methods, __ll__)
                    return OpSpec.NULL
                T = fields[name]

                def get(self: cls, attr: str) -> T:
                    return getattr(self.__ll__, name)

                return OpSpec(get)

            @blue.metafunc
            def __setattr__(m_self, m_name, m_v):
                name = m_name.blueval
                if name not in fields:
                    return OpSpec.NULL
                T = fields[name]

                def set(self: cls, attr: str, v: T) -> None:
                    setattr(self.__ll__, name, v)

                return OpSpec(set)

            # Default constructor: allocate, then run the user's __init__.
            # "The class wins": if the body already has a __new__ (written by
            # the user, or generated by a transformer such as @dataclass), it
            # is used instead. (`if` is allowed in a class body.)
            if "__new__" not in body.methods:

                @blue.metafunc
                def __new__(*m_args):
                    arg_types = m_args.types

                    def new(*args: tuple[*arg_types]) -> cls:
                        self = cls.__make__(gc_alloc[Data](1))
                        self.__init__(*args)
                        return self

                    return OpSpec(new)

            @blue.metafunc
            def __is__(m_self, m_other):
                def impl(self: cls, other: cls) -> bool:
                    return self.__ll__ == other.__ll__

                return OpSpec(impl, [m_self, m_other])

            # Contract with transformers (see dataclass.spy): build an object
            # from the values of its fields, in declaration order, without
            # calling __init__. For a plain struct, this is `__make__`.
            def __from_fields__(*args: tuple[*types]) -> cls:
                p = gc_alloc[Data](1)
                p[0] = Data.__make__(*args)
                return cls.__make__(p)

            # What a heap class offers to other modifiers (see protocol.spy):
            # the object as an untyped pointer, and back. This is a contract
            # between definers. The page uses `Circle_data` for this without
            # saying where it comes from.
            def __erase__(self) -> gc_ptr[void]:
                return ptr_cast[gc_ptr[void]](self.__ll__)

            def __unerase__(p: gc_ptr[void]) -> cls:
                return cls.__make__(ptr_cast[gc_ptr[Data]](p))

        # Second: the data struct. Open question: how to name it `Point_data`.
        @struct
        class Data:
            __extra_fields__ = fields
